@page "/approval/handle"
@model Atlas_Web.Pages.ApprovalRequest.ApprovalHandlerModel
@{
    ViewData["Title"] = "Approval Decision Recorded";
}

<div class="approval-handler-page">
    <div class="container">
        <div class="section">
            <div class="columns is-centered">
                <div class="column is-6">
                    
                    @if (Model.Success)
                    {
                        <!-- Success Message -->
                        <div class="card">
                            <div class="card-content has-text-centered">
                                <div class="mb-4">
                                    @if (Model.Action == "Approved")
                                    {
                                        <span class="icon is-large has-text-success">
                                            <i class="fas fa-check-circle fa-4x"></i>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="icon is-large has-text-danger">
                                            <i class="fas fa-times-circle fa-4x"></i>
                                        </span>
                                    }
                                </div>
                                
                                <h1 class="title is-4">Request @Model.Action</h1>
                                <p class="subtitle is-6">Request ID: <code>@Model.RequestId</code></p>
                                
                                <div class="content">
                                    <p>
                                        <strong>File:</strong> @Model.FileName<br>
                                        <strong>Requested by:</strong> @Model.RequesterName<br>
                                        <strong>Decision by:</strong> @Model.ApproverName<br>
                                        <strong>Date:</strong> @DateTime.Now.ToString("MMMM dd, yyyy h:mm tt")
                                    </p>
                                </div>

                                <div class="notification @(Model.Action == "Approved" ? "is-success" : "is-info") is-light">
                                    @if (Model.Action == "Approved")
                                    {
                                        <p>The requester will be notified that their request has been approved.</p>
                                    }
                                    else
                                    {
                                        <p>The requester will be notified that their request was not approved at this time.</p>
                                    }
                                </div>

                                <div class="buttons is-centered mt-5">
                                    <a href="/" class="button is-primary">
                                        <span class="icon">
                                            <i class="fas fa-home"></i>
                                        </span>
                                        <span>Return to Atlas</span>
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <!-- Error Message -->
                        <div class="card">
                            <div class="card-content has-text-centered">
                                <div class="mb-4">
                                    <span class="icon is-large has-text-warning">
                                        <i class="fas fa-exclamation-triangle fa-4x"></i>
                                    </span>
                                </div>
                                
                                <h1 class="title is-4">Unable to Process Decision</h1>
                                
                                <div class="notification is-warning">
                                    <p><strong>@Model.ErrorMessage</strong></p>
                                </div>

                                <div class="buttons is-centered mt-5">
                                    <a href="/" class="button is-primary">
                                        <span class="icon">
                                            <i class="fas fa-home"></i>
                                        </span>
                                        <span>Return to Atlas</span>
                                    </a>
                                </div>
                            </div>
                        </div>
                    }

                </div>
            </div>
        </div>
    </div>
</div>
